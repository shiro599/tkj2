<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Panel - Expo SMKN 3 Payakumbuh</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen p-6">
  <div class="max-w-5xl mx-auto">
    <h1 class="text-4xl font-bold text-center mb-8">Data Absensi Expo</h1>

    <div class="flex justify-between mb-6">
      <button id="logoutBtn" class="bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700">Logout</button>
      <button id="clearBtn" class="bg-yellow-500 text-white px-4 py-2 rounded hover:bg-yellow-600">Hapus Semua Data</button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-white rounded-xl shadow p-4">
        <h2 class="text-2xl font-semibold mb-4">Absensi Murid</h2>
        <ul id="muridList" class="space-y-2 text-sm"></ul>
      </div>
      <div class="bg-white rounded-xl shadow p-4">
        <h2 class="text-2xl font-semibold mb-4">Absensi Guru</h2>
        <ul id="guruList" class="space-y-2 text-sm"></ul>
      </div>
    </div>
  </div>

  <script>
    // Cek login admin
    if (localStorage.getItem("adminLogin") !== "true") {
      alert("Akses ditolak. Silakan login dari halaman utama.");
      window.location.href = "index.html";
    }

    const muridList = document.getElementById("muridList");
    const guruList = document.getElementById("guruList");

    function tampilkanData(key, target) {
      const data = JSON.parse(localStorage.getItem(key) || "[]");
      if (data.length === 0) {
        target.innerHTML = "<li class='text-gray-500'>Belum ada data.</li>";
        return;
      }
      data.forEach((item, i) => {
        const el = document.createElement("li");
        el.classList.add("border", "rounded", "p-2", "bg-gray-100");
        el.textContent = ${i + 1}. ${item.nama} - ${item.instansi}${item.kelas ? " - Kelas " + item.kelas : ""};
        target.appendChild(el);
      });
    }

    tampilkanData("absensiMurid", muridList);
    tampilkanData("absensiGuru", guruList);

    document.getElementById("logoutBtn").addEventListener("click", () => {
      localStorage.removeItem("adminLogin");
      window.location.href = "index.html";
    });

    document.getElementById("clearBtn").addEventListener("click", () => {
      if (confirm("Yakin ingin menghapus semua data?")) {
        localStorage.removeItem("absensiMurid");
        localStorage.removeItem("absensiGuru");
        location.reload();
      }
    });
  </script>
</body>
</html>
